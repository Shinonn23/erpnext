 "fields": [
  {
   "fieldname": "setup_tab",
   "fieldtype": "Tab Break",
   "label": "Count Setup"
  },
  {
   "fieldname": "count_details_section",
   "fieldtype": "Section Break",
   "label": "Count Details"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "remember_last_selected_value": 1
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Link",
   "label": "Warehouse",
   "options": "Warehouse",
   "reqd": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "count_type",
   "fieldtype": "Select",
   "label": "Count Type",
   "options": "Monthly\nAnnual",
   "reqd": 1
  },
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "STOCK-COUNT-.YYYY.-",
   "reqd": 1,
   "set_only_once": 1
  },
  {
   "fieldname": "count_setup_section",
   "fieldtype": "Section Break",
   "label": "Monthly Count Setup",
   "depends_on": "eval:doc.count_type == 'Monthly'"
  },
  {
   "fieldname": "item_selection",
   "fieldtype": "Select",
   "label": "Item Selection",
   "options": "Random Sample\nSelected Items",
   "default": "Random Sample",
   "depends_on": "eval:doc.count_type == 'Monthly'",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Random Sample counts a random number of items with stock; Selected Items counts only the items you choose. An Annual count always counts every item."
  },
  {
   "depends_on": "eval:doc.count_type == 'Monthly' && doc.item_selection != 'Selected Items'",
   "fieldname": "item_count",
   "fieldtype": "Int",
   "label": "Number of Item Codes to Sample",
   "default": "10",
   "mandatory_depends_on": "eval:doc.count_type == 'Monthly' && doc.item_selection != 'Selected Items'",
   "description": "Used when Item Selection is Random Sample."
  },
  {
   "fieldname": "count_setup_column",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.count_type == 'Monthly'",
   "fieldname": "quarantine_warehouse",
   "fieldtype": "Link",
   "label": "Quarantine Warehouse",
   "options": "Warehouse",
   "description": "Required unless the Warehouse posts count differences as a Stock Reconciliation."
  },
  {
   "depends_on": "eval:doc.count_type == 'Monthly'",
   "fieldname": "quarantine_storage_location",
   "fieldtype": "Link",
   "label": "Quarantine Storage Location",
   "options": "Storage Location",
   "description": "Optional destination location in the Quarantine Warehouse."
  },
  {
   "fieldname": "selected_items_section",
   "fieldtype": "Section Break",
   "label": "Items to Count",
   "depends_on": "eval:doc.count_type == 'Monthly' && doc.item_selection == 'Selected Items'"
  },
  {
   "fieldname": "count_template",
   "fieldtype": "Link",
   "label": "Count Template",
   "options": "Stock Count Template",
   "description": "Fills Items to Count. Changing the template later does not change a prepared count.",
   "in_standard_filter": 1
  },
  {
   "fieldname": "selected_items",
   "fieldtype": "Table",
   "label": "Items to Count",
   "options": "Stock Count Selected Item"
  },
  {
   "fieldname": "dimensions_section",
   "fieldtype": "Section Break",
   "label": "Inventory Dimension Filters",
   "collapsible": 1
  },
  {
   "fieldname": "dimensions",
   "fieldtype": "Table",
   "label": "Inventory Dimensions",
   "options": "Stock Count Dimension"
  },
  {
   "fieldname": "counting_tab",
   "fieldtype": "Tab Break",
   "label": "Counting"
  },
  {
   "depends_on": "eval:doc.status == 'In Progress' && doc.docstatus == 0 && (!doc.workflow_state || doc.workflow_state == 'Stock Count Draft')",
   "fieldname": "scanning_section",
   "fieldtype": "Section Break",
   "label": "Scan Items"
  },
  {
   "depends_on": "eval:doc.status == 'In Progress' && doc.docstatus == 0 && (!doc.workflow_state || doc.workflow_state == 'Stock Count Draft')",
   "fieldname": "scan_storage_location",
   "fieldtype": "Link",
   "label": "Scan Storage Location",
   "options": "Storage Location",
   "print_hide": 1,
   "description": "Select the location being counted before scanning items stored in multiple locations.",
   "no_copy": 1
  },
  {
   "fieldname": "scanning_column",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.status == 'In Progress' && doc.docstatus == 0 && (!doc.workflow_state || doc.workflow_state == 'Stock Count Draft')",
   "fieldname": "scan_barcode",
   "fieldtype": "Data",
   "label": "Scan Item, Batch, or Serial No",
   "print_hide": 1,
   "options": "Barcode"
  },
  {
   "fieldname": "items_section",
   "fieldtype": "Section Break",
   "label": "Count Items"
  },
  {
   "allow_bulk_edit": 1,
   "cannot_add_rows": 1,
   "cannot_delete_rows": 1,
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "Stock Count Item",
   "no_copy": 1
  },
  {
   "fieldname": "review_tab",
   "fieldtype": "Tab Break",
