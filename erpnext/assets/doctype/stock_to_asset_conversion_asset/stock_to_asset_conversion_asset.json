{
 "doctype": "DocType",
 "editable_grid": 1,
 "engine": "InnoDB",
 "field_order": [
  "source_item_row",
  "source_unit_index",
  "asset_item_code",
  "asset_serial_number",
  "source_serial_no",
  "source_batch_no",
  "asset_category",
  "accounting_treatment",
  "purchase_price_source",
  "purchase_reference_type",
  "purchase_reference",
  "purchase_reference_item",
  "purchase_unit_price",
  "purchase_price_reason",
  "expense_account",
  "asset_value",
  "asset_location",
  "asset"
 ],
 "fields": [
  {
   "fieldname": "source_item_row",
   "fieldtype": "Link",
   "label": "Source Stock Item Row",
   "options": "Stock to Asset Conversion Item",
   "read_only": 1
  },
  {
   "fieldname": "source_unit_index",
   "fieldtype": "Int",
   "label": "Source Unit Index",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "asset_item_code",
   "fieldtype": "Link",
   "label": "Asset Item Code",
   "options": "Item",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "asset_serial_number",
   "fieldtype": "Data",
   "label": "Asset Serial Number",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "source_serial_no",
   "fieldtype": "Link",
   "label": "Source Serial No",
   "options": "Serial No",
   "read_only": 1
  },
  {
   "fieldname": "source_batch_no",
   "fieldtype": "Link",
   "label": "Source Batch No",
   "options": "Batch",
   "read_only": 1
  },
  {
   "fieldname": "asset_category",
   "fieldtype": "Link",
   "label": "Asset Category",
   "options": "Asset Category",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "accounting_treatment",
   "fieldtype": "Select",
   "label": "Accounting Treatment",
   "options": "Capitalize\nExpense Immediately",
   "default": "Capitalize",
   "in_list_view": 1
  },
  {
   "fieldname": "purchase_price_source",
   "fieldtype": "Select",
   "label": "Purchase Price Source",
   "options": "Purchase Document\nManual Evidence",
   "default": "Purchase Document",
   "depends_on": "eval:doc.accounting_treatment == \"Expense Immediately\"",
   "description": "Choose a purchase document or enter a price with an explanation."
  },
  {
   "fieldname": "purchase_reference_type",
   "fieldtype": "Select",
   "label": "Purchase Reference Type",
   "options": "Purchase Receipt\nPurchase Invoice",
   "default": "Purchase Receipt",
   "depends_on": "eval:doc.accounting_treatment == \"Expense Immediately\" && doc.purchase_price_source != \"Manual Evidence\""
  },
  {
   "fieldname": "purchase_reference",
   "fieldtype": "Dynamic Link",
   "label": "Purchase Reference",
   "options": "purchase_reference_type",
   "depends_on": "eval:doc.accounting_treatment == \"Expense Immediately\" && doc.purchase_price_source != \"Manual Evidence\""
  },
  {
   "fieldname": "purchase_reference_item",
   "fieldtype": "Data",
   "label": "Purchase Reference Item",
   "read_only": 1,
   "depends_on": "eval:doc.accounting_treatment == \"Expense Immediately\" && doc.purchase_price_source != \"Manual Evidence\""
  },
  {
   "fieldname": "purchase_unit_price",
   "fieldtype": "Currency",
   "label": "Purchase Unit Price (THB)",
   "options": "Company:company:default_currency",
   "description": "Purchase price per stock unit, excluding recoverable VAT. Derived from the reference or entered by accounting with evidence.",
   "depends_on": "eval:doc.accounting_treatment == \"Expense Immediately\"",
   "read_only_depends_on": "eval:doc.purchase_price_source != \"Manual Evidence\""
  },
  {
   "fieldname": "purchase_price_reason",
   "fieldtype": "Small Text",
   "label": "Purchase Price Explanation",
   "depends_on": "eval:doc.accounting_treatment == \"Expense Immediately\" && doc.purchase_price_source == \"Manual Evidence\""
  },
  {
   "fieldname": "expense_account",
   "fieldtype": "Link",
   "label": "Demo Expense Account",
   "options": "Account",
   "depends_on": "eval:doc.accounting_treatment == \"Expense Immediately\""
  },
  {
   "fieldname": "asset_value",
   "fieldtype": "Currency",
   "label": "Stock Conversion Cost",
   "description": "The stock cost. Immediate expense creates a tracking Asset with zero value.",
   "options": "Company:company:default_currency",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "asset_location",
   "fieldtype": "Link",
   "label": "Asset Location",
   "options": "Location",
   "in_list_view": 1
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "Created Asset",
   "options": "Asset",
   "read_only": 1
  }
 ],
 "istable": 1,
 "module": "Assets",
 "name": "Stock to Asset Conversion Asset",
 "permissions": [],
 "track_changes": 1
}
