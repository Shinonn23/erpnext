 "fields": [
  {
   "fieldname": "details_tab",
   "fieldtype": "Tab Break",
   "label": "Loan"
  },
  {
   "fieldname": "loan_details_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "material_request",
   "fieldtype": "Link",
   "label": "Material Request",
   "options": "Material Request",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "loan_type",
   "fieldtype": "Select",
   "label": "Loan Type",
   "options": "Stock\nAsset",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPending Pick\nPending Delivery\nPending Quality Inspection\nPending Receipt\nActive\nPartially Returned\nReturned\nClosed\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "loan_details_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "borrower_type",
   "fieldtype": "Select",
   "label": "Borrower Type",
   "options": "Employee\nCustomer\nSupplier\nContact",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "borrower",
   "fieldtype": "Dynamic Link",
   "label": "Borrower",
   "options": "borrower_type",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "expected_return_date",
   "fieldtype": "Date",
   "label": "Expected Return Date",
   "reqd": 1
  },
  {
   "fieldname": "borrower_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "requested_by",
   "fieldtype": "Link",
   "label": "Responsible Employee",
   "options": "Employee",
   "read_only": 1,
   "allow_on_submit": 1,
   "in_standard_filter": 1,
   "description": "The Responsible Employee named on the Material Request: answers for the items until they come back.",
   "bold": 1
  },
  {
   "fieldname": "requested_by_name",
   "fieldtype": "Data",
   "label": "Responsible Employee Name",
   "fetch_from": "requested_by.employee_name",
   "read_only": 1,
   "allow_on_submit": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "items_section",
   "fieldtype": "Section Break",
   "label": "Items"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "Custody Loan Item",
   "reqd": 1
  },
  {
   "fieldname": "serial_batch_section",
   "fieldtype": "Section Break",
   "label": "Serial / Batch Tracking",
   "depends_on": "eval:doc.loan_type == 'Stock' && doc.docstatus == 1",
   "collapsible": 1,
   "collapsible_depends_on": "eval:true"
  },
  {
   "fieldname": "serial_batch_details",
   "fieldtype": "Table",
   "label": "Serial / Batch Tracking",
   "options": "Custody Loan Serial Batch",
   "read_only": 1,
   "allow_on_submit": 1,
   "no_copy": 1,
   "description": "Every batch and serial number issued on this loan and where it stands: with the borrower, pending return, returned or written off."
  },
  {
   "fieldname": "placement_section",
   "fieldtype": "Section Break",
   "label": "Placement Confirmation",
   "depends_on": "eval:doc.docstatus == 1 && doc.borrower_type == 'Customer' && !['Pending Pick', 'Pending Delivery'].includes(doc.status)",
   "description": "The Service Engineer confirms where the items were placed at the customer, after delivery."
  },
  {
   "fieldname": "placement_confirmation",
   "fieldtype": "Attach",
   "label": "Placement Confirmation",
   "allow_on_submit": 1,
   "no_copy": 1
  },
  {
   "fieldname": "placement_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "placement_confirmed_by",
   "fieldtype": "Link",
   "label": "Confirmed By",
   "options": "Employee",
   "allow_on_submit": 1,
   "no_copy": 1
  },
  {
   "fieldname": "demo_extension_section",
   "fieldtype": "Section Break",
   "label": "Demo Return Date Extension",
   "collapsible": 1,
   "depends_on": "eval:doc.demo_extension_state",
   "collapsible_depends_on": "eval:doc.demo_extension_state == 'Pending'"
  },
  {
   "fieldname": "demo_extension_date",
   "label": "Requested Return Date",
   "fieldtype": "Date",
   "read_only": 1,
   "allow_on_submit": 1,
   "no_copy": 1
